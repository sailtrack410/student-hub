@import "styles/tokens.wxss";

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 30rpx;
  box-sizing: border-box;
}

/* 主按钮 */
.btn-primary {
  background: var(--grad-brand);
  color: #fff;
  border-radius: 44rpx;
  font-weight: 600;
  font-size: 30rpx;
  border: none;
  /* 覆盖 button 默认行高与内边距，flex 垂直居中保证文字上下对齐 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0 40rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.55;
  color: #fff;
}

/* 次按钮 */
.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand);
  border-radius: 44rpx;
  font-weight: 600;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0 40rpx;
}

.btn-ghost::after {
  border: none;
}

/* 安全区底部占位 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
