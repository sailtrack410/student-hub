.timeline {
  padding: 10rpx 0;
}

.tl-item {
  display: flex;
}

.tl-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
}

.tl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #CBD5E1;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tl-dot-first {
  width: 22rpx;
  height: 22rpx;
  margin-top: 8rpx;
  background: var(--brand);
  box-shadow: 0 0 0 8rpx var(--brand-soft);
}

.tl-line {
  width: 4rpx;
  flex: 1;
  background: #E2E8F0;
  margin: 6rpx 0;
  border-radius: 2rpx;
}

.tl-body {
  flex: 1;
  padding: 0 0 34rpx 16rpx;
}

.tl-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tl-action {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.tl-time {
  font-size: 22rpx;
  color: var(--text-3);
}

.tl-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.tl-comment {
  margin-top: 10rpx;
  padding: 14rpx 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-2);
}
