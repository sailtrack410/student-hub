<view class="timeline">
  <view wx:for="{{logs}}" wx:key="index" class="tl-item">
    <view class="tl-rail">
      <view class="tl-dot {{index === 0 ? 'tl-dot-first' : ''}}"></view>
      <view wx:if="{{index < logs.length - 1}}" class="tl-line"></view>
    </view>
    <view class="tl-body">
      <view class="tl-head">
        <text class="tl-action">{{item.actionText}}</text>
        <text class="tl-time">{{item.timeText}}</text>
      </view>
      <view class="tl-meta">{{item.operatorName}}</view>
      <view wx:if="{{item.comment}}" class="tl-comment">{{item.comment}}</view>
    </view>
  </view>
</view>
