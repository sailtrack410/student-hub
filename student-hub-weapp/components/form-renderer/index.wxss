/* 组件宿主置为块级，避免内联布局导致子元素事件异常 */
:host {
  display: block;
  width: 100%;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 14rpx;
}

.required {
  color: var(--danger);
  margin-right: 6rpx;
}

.field-input {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
}

.field-textarea {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
}

.field-picker {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-1);
}

.field-picker-empty {
  color: var(--text-3);
}

.arrow {
  color: var(--text-3);
}

.field-disabled {
  background: #F1F5F9;
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.ph {
  color: var(--text-3);
}
