/* 组件宿主置为块级，避免内联布局导致子元素事件异常 */
:host {
  display: block;
  width: 100%;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 14rpx;
}

.required {
  color: var(--danger);
  margin-right: 6rpx;
}

.field-input {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
}

.field-textarea {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
}

.field-picker {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-1);
}

.field-picker-empty {
  color: var(--text-3);
}

.arrow {
  color: var(--text-3);
}

.field-disabled {
  background: #F1F5F9;
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.image-cell {
  position: relative;
  width: 176rpx;
  height: 176rpx;
}

.image-thumb {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
  background: var(--bg-page);
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--danger);
  color: #fff;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.image-add {
  width: 176rpx;
  height: 176rpx;
  border-radius: var(--radius-md);
  background: var(--bg-page);
  border: 2rpx dashed var(--border);
  position: relative;
}

.image-add-busy {
  opacity: 0.5;
}

.plus-v,
.plus-h {
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--text-3);
  border-radius: 2rpx;
}

.plus-v {
  width: 4rpx;
  height: 44rpx;
  transform: translate(-50%, -50%);
}

.plus-h {
  width: 44rpx;
  height: 4rpx;
  transform: translate(-50%, -50%);
}

.image-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.ph {
  color: var(--text-3);
}
