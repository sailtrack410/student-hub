<view class="form">
  <view wx:for="{{fields}}" wx:key="key" class="field">
    <view class="field-label">
      <text wx:if="{{item.required}}" class="required">*</text>
      <text>{{item.label}}</text>
    </view>

    <input
      wx:if="{{item.type === 'input'}}"
      class="field-input"
      value="{{item.display}}"
      placeholder="{{item.placeholder || '请输入'}}"
      data-index="{{index}}"
      bindinput="onInput"
      placeholder-class="ph"
    />

    <input
      wx:elif="{{item.type === 'number'}}"
      class="field-input"
      type="number"
      value="{{item.display}}"
      placeholder="{{item.placeholder || '请输入数字'}}"
      data-index="{{index}}"
      bindinput="onInput"
      placeholder-class="ph"
    />

    <textarea
      wx:elif="{{item.type === 'textarea'}}"
      class="field-textarea"
      value="{{item.display}}"
      placeholder="{{item.placeholder || '请输入'}}"
      maxlength="{{item.max || 500}}"
      data-index="{{index}}"
      bindinput="onInput"
      auto-height
      placeholder-class="ph"
    />

    <picker
      wx:elif="{{item.type === 'select'}}"
      mode="selector"
      range="{{item.options}}"
      data-index="{{index}}"
      bindchange="onPick"
    >
      <view class="field-picker {{item.display ? '' : 'field-picker-empty'}}">
        <text>{{item.display || '请选择'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>

    <picker
      wx:elif="{{item.type === 'date'}}"
      mode="date"
      data-index="{{index}}"
      bindchange="onPick"
    >
      <view class="field-picker {{item.display ? '' : 'field-picker-empty'}}">
        <text>{{item.display || '请选择日期'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>

    <view wx:elif="{{item.type === 'image'}}" class="image-field">
      <view class="image-grid">
        <view wx:for="{{item.urls}}" wx:key="*this" wx:for-item="url" wx:for-index="imgIndex" class="image-cell">
          <image
            class="image-thumb"
            src="{{url}}"
            mode="aspectFill"
            data-field="{{index}}"
            data-img="{{imgIndex}}"
            bindtap="onPreviewImage"
          />
          <view class="image-remove" data-field="{{index}}" data-img="{{imgIndex}}" catchtap="onRemoveImage">×</view>
        </view>
        <view
          wx:if="{{item.urls.length < (item.maxCount || 3)}}"
          class="image-add {{item.uploading ? 'image-add-busy' : ''}}"
          data-field="{{index}}"
          bindtap="onAddImage"
        >
          <view class="plus-v"></view>
          <view class="plus-h"></view>
        </view>
      </view>
      <view class="image-hint">{{item.placeholder || '拍照或从相册选择'}}</view>
    </view>
  </view>
</view>
