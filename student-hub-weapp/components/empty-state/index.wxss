.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 40rpx;
}

.empty-img {
  width: 320rpx;
  height: 240rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.empty-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
  text-align: center;
}
