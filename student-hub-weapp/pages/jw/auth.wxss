.jw {
  padding: 24rpx 30rpx;
}

.status-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.status-info {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}

.status-value {
  font-size: 28rpx;
  font-weight: 700;
}

.status-UNBOUND {
  color: var(--text-3);
}

.status-AUTHENTICATED {
  color: var(--success);
}

.status-EXPIRED {
  color: var(--warning);
}

.form {
  margin-top: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 26rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field-input {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
}

.field-tip {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.captcha-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.captcha-input {
  flex: 1;
}

.captcha-img {
  width: 220rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: #fff;
  border: 2rpx solid var(--border);
  flex-shrink: 0;
}

.captcha-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3);
}

.submit {
  margin-top: 16rpx;
  height: 92rpx;
}

.section {
  margin-top: 24rpx;
}

.menu {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.menu-text.danger {
  color: var(--danger);
}

.menu-arrow {
  color: var(--text-3);
  font-size: 32rpx;
}

.page-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  padding: 0 30rpx;
}

.ph {
  color: var(--text-3);
}
