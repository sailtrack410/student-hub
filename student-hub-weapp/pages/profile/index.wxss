.profile {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  position: relative;
  padding: 0 30rpx;
  padding-top: 140rpx;
  padding-bottom: 90rpx;
}

.header-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.user {
  position: relative;
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.avatar-wrap {
  position: relative;
  width: 132rpx;
  height: 132rpx;
}

.avatar {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--bg-card);
}

.avatar-frame {
  position: absolute;
  left: 0;
  top: 0;
  width: 132rpx;
  height: 132rpx;
}

.user-body {
  flex: 1;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.25);
}

.user-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.login-btn {
  background: #fff;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 12rpx 36rpx;
}

.stats {
  margin: -60rpx 30rpx 0;
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--border);
}

.section {
  margin: 24rpx 30rpx 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.menu-value {
  font-size: 25rpx;
  color: var(--text-2);
  max-width: 320rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.menu {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.menu-arrow {
  color: var(--text-3);
  font-size: 32rpx;
}

.badge {
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-right: 8rpx;
}

.version {
  margin-top: 50rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
