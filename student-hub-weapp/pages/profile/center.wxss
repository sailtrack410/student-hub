.center {
  padding: 24rpx 30rpx;
}

.center > .card,
.card {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}

.row-label {
  width: 110rpx;
  font-size: 27rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-1);
}

.row-empty {
  color: var(--text-3);
}

.row-input {
  flex: 1;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 16rpx 22rpx;
  font-size: 27rpx;
}

.avatar-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--bg-page);
}

.avatar-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--bg-page);
  color: var(--text-3);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn,
.mini-save {
  flex-shrink: 0;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 0 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
}

.mini-ghost {
  background: var(--bg-page);
  color: var(--text-2);
}

.avatar-btn::after,
.mini-save::after {
  border: none;
}

.manual-phone {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 14rpx 0 4rpx 130rpx;
}

.manual-phone .row-input {
  flex: 1;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--bg-page);
}

.kv:last-child {
  border-bottom: none;
}

.kv-key {
  color: var(--text-2);
}

.kv-value {
  color: var(--text-1);
  font-weight: 500;
  text-align: right;
}

.reauth-btn {
  height: 88rpx;
  margin-top: 10rpx;
}

.ph {
  color: var(--text-3);
}
