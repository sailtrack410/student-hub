<view class="center">
  <!-- 基础资料 -->
  <view class="card">
    <view class="section-title">基础资料</view>

    <view class="row">
      <text class="row-label">头像</text>
      <image class="avatar-img" src="{{avatarUrl || '/assets/mascot/mascot-avatar.jpg'}}" mode="aspectFill" />
      <view class="row-actions">
        <button class="avatar-btn" size="mini" open-type="chooseAvatar" chooseAvatar="{{true}}" bindchooseavatar="onChooseAvatar">
          更换
        </button>
        <button wx:if="{{avatarUrl}}" class="avatar-btn mini-ghost" size="mini" bindtap="onResetAvatar">
          默认
        </button>
      </view>
    </view>

    <view class="row">
      <text class="row-label">昵称</text>
      <input class="row-input" type="nickname" value="{{displayName}}" placeholder="请输入昵称"
             placeholder-class="ph" bindinput="onDisplayNameInput" />
      <button class="mini-save" size="mini" bindtap="saveDisplayName">保存</button>
    </view>

    <view class="row">
      <text class="row-label">手机号</text>
      <text wx:if="{{phone}}" class="row-value">{{phone}}</text>
      <text wx:else class="row-value row-empty">未绑定</text>
      <button wx:if="{{!phone}}" class="mini-save" size="mini" open-type="getPhoneNumber"
              bindgetphonenumber="onWechatPhone">微信号绑定</button>
      <button wx:else class="mini-save mini-ghost" size="mini" bindtap="manualPhone">更换</button>
    </view>
    <view wx:if="{{showManualPhone}}" class="manual-phone">
      <input class="row-input" type="number" maxlength="11" value="{{manualPhoneValue}}"
             placeholder="手动输入手机号" placeholder-class="ph" bindinput="onManualPhoneInput" />
      <button class="mini-save" size="mini" bindtap="saveManualPhone">保存</button>
    </view>
  </view>

  <!-- 教务系统信息（失效也保留展示） -->
  <view class="card" wx:if="{{jwBound}}">
    <view class="section-title-row">
      <view class="section-title">教务系统信息</view>
      <status-tag text="{{jwStatusText}}" theme="{{jwStatusTheme}}" />
    </view>
    <view class="kv"><text class="kv-key">姓名</text><text class="kv-value">{{jwName}}</text></view>
    <view class="kv"><text class="kv-key">账号</text><text class="kv-value">{{ssoAccount}}</text></view>
    <view class="kv" wx:if="{{grade}}"><text class="kv-key">年级</text><text class="kv-value">{{grade}}</text></view>
    <view class="kv" wx:if="{{college}}"><text class="kv-key">院(系)/部</text><text class="kv-value">{{college}}</text></view>
    <view class="kv" wx:if="{{major}}"><text class="kv-key">专业</text><text class="kv-value">{{major}}</text></view>
    <view class="kv" wx:if="{{className}}"><text class="kv-key">班级</text><text class="kv-value">{{className}}</text></view>
    <view class="kv" wx:if="{{jwStudentNo}}"><text class="kv-key">教务学号</text><text class="kv-value">{{jwStudentNo}}</text></view>
  </view>

  <!-- 登录状态 -->
  <view class="card">
    <view class="section-title-row">
      <view class="section-title">登录状态</view>
      <status-tag wx:if="{{jwBound}}" text="{{jwStatusText}}" theme="{{jwStatusTheme}}" />
      <status-tag wx:else text="未认证" theme="gray" />
    </view>
    <button wx:if="{{jwExpired}}" class="btn-primary reauth-btn" bindtap="goReauth">重新认证</button>
    <button wx:if="{{!jwBound}}" class="btn-primary reauth-btn" bindtap="goReauth">去认证</button>
  </view>

  <view class="safe-bottom"></view>
</view>
