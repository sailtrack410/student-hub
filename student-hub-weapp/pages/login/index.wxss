.login {
  min-height: 100vh;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
}

.hero {
  width: 100%;
  height: 640rpx;
}

.body {
  flex: 1;
  padding: 40rpx 60rpx 80rpx;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.brand-logo {
  width: 96rpx;
  height: 96rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
}

.brand-slogan {
  font-size: 26rpx;
  color: var(--text-2);
}

.features {
  margin-top: 60rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.feature {
  flex: 1;
  background: var(--grad-brand-light);
  border-radius: var(--radius-md);
  padding: 26rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--text-1);
  font-weight: 500;
}

.feature-emoji {
  font-size: 44rpx;
}

.login-btn {
  margin-top: auto;
  height: 96rpx;
  line-height: 96rpx;
}

.agreement {
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
