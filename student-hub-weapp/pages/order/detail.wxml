<view class="detail" wx:if="{{detail}}">
  <view class="status-hero status-hero-{{detail.statusTheme}}"><view class="hero-left"><view class="hero-status">{{detail.statusText}}</view><view class="hero-title">{{detail.title}}</view><view class="hero-no">{{detail.orderNo}}</view></view></view>
  <view class="card section"><view class="section-title">处理信息</view><view class="kv"><text class="kv-key">工单号</text><text class="kv-value">{{detail.orderNo}}</text></view><view class="kv"><text class="kv-key">报修人</text><text class="kv-value">{{detail.requesterName || '-'}}</text></view><view class="kv"><text class="kv-key">联系方式</text><text class="kv-value">{{detail.requesterPhone || '-'}}</text></view><view class="kv"><text class="kv-key">报修地址</text><text class="kv-value">{{detail.repairAddress || '-'}}</text></view><view class="kv"><text class="kv-key">派单时间</text><text class="kv-value">{{detail.assignedAtText || '-'}}</text></view><view wx:if="{{detail.startedAt}}" class="kv"><text class="kv-key">开始时间</text><text class="kv-value">{{detail.startedAtText}}</text></view><view wx:if="{{detail.completionSubmittedAt}}" class="kv"><text class="kv-key">完工提交时间</text><text class="kv-value">{{detail.completionSubmittedAtText}}</text></view><view wx:if="{{detail.confirmedAt}}" class="kv"><text class="kv-key">确认时间</text><text class="kv-value">{{detail.confirmedAtText}}</text></view></view>
  <view class="card section" wx:if="{{formRows.length}}"><view class="section-title">申请内容</view><view wx:for="{{formRows}}" wx:key="key" class="kv"><text class="kv-key">{{item.label}}</text><view wx:if="{{item.images.length}}" class="images"><image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" /></view><text wx:else class="kv-value">{{item.valueText}}</text></view></view>
  <view class="card section"><view class="section-title">办理进度</view><view wx:for="{{progress}}" wx:key="key" class="progress-row {{item.done ? 'progress-done' : ''}} {{item.current ? 'progress-current' : ''}}"><view class="progress-dot"></view><view class="progress-body"><view class="progress-title">{{item.title}}</view><view class="progress-action">{{item.action}}</view></view></view></view>
  <view class="card section" wx:if="{{detail.arrivalPhotoUrl || detail.completionPhotoUrls.length || detail.completionPhotoUrl || detail.completeRemark || detail.confirmationRejectReason}}"><view class="section-title">现场记录</view><view wx:if="{{detail.arrivalPhotoUrl}}" class="photo-row"><text>现场照片</text><image src="{{detail.arrivalPhotoUrl}}" mode="aspectFill" /></view><view wx:if="{{detail.completionPhotoUrls.length || detail.completionPhotoUrl}}" class="photo-row"><text>完工照片</text><view class="photo-list"><image wx:for="{{detail.completionPhotoUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" /><image wx:if="{{!detail.completionPhotoUrls.length && detail.completionPhotoUrl}}" src="{{detail.completionPhotoUrl}}" mode="aspectFill" /></view></view><view wx:if="{{detail.completeRemark}}" class="remark">{{detail.completeRemark}}</view><view wx:if="{{detail.confirmationRejectReason}}" class="reject">报修人退回：{{detail.confirmationRejectReason}}</view></view>
  <view wx:if="{{detail.status === 'ASSIGNED' || detail.status === 'PROCESSING' || detail.status === 'ONSITE_PHOTO_RECORDED'}}" class="actions safe-bottom"><button wx:if="{{detail.status === 'ASSIGNED'}}" class="btn-primary action-btn" loading="{{submitting}}" bindtap="start">确认接单</button><button wx:elif="{{detail.status === 'PROCESSING'}}" class="btn-primary action-btn" loading="{{submitting}}" bindtap="recordArrival">现场拍照</button><button wx:elif="{{detail.status === 'ONSITE_PHOTO_RECORDED'}}" class="btn-primary action-btn" loading="{{submitting}}" bindtap="submitCompletion">上传完工照片并提交</button></view>
  <view wx:elif="{{detail.status === 'PENDING_CONFIRMATION'}}" class="waiting safe-bottom">已提交完工照片，等待报修人确认</view>
</view>
<view wx:if="{{loading}}" class="loading">加载中</view><view wx:if="{{!loading && !detail}}" class="loading">工单不存在或无权查看</view>
