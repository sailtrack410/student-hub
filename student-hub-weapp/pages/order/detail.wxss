.detail { min-height: 100vh; padding: 24rpx 30rpx 60rpx; background: #F5F7FB; box-sizing: border-box; }
.status-hero { padding: 34rpx; border-radius: 14rpx; color: #fff; }.status-hero-blue { background: #2563EB; }.status-hero-amber { background: #D97706; }.status-hero-green { background: #16A34A; }.status-hero-red { background: #DC2626; }.status-hero-gray { background: #64748B; }
.hero-status { font-size: 40rpx; font-weight: 700; }.hero-title { margin-top: 10rpx; font-size: 28rpx; }.hero-no { margin-top: 8rpx; font-size: 22rpx; opacity: .8; }
.section { margin-top: 24rpx; padding: 26rpx; }.section-title { margin-bottom: 14rpx; font-size: 30rpx; font-weight: 700; color: #0F172A; }.kv { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 15rpx 0; border-bottom: 1rpx solid #E8EDF3; font-size: 25rpx; }.kv:last-child { border-bottom: 0; }.kv-key { flex-shrink: 0; color: #64748B; }.kv-value { max-width: 70%; color: #1E293B; text-align: right; word-break: break-all; }
.images { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; max-width: 70%; }.images image, .photo-row image { width: 132rpx; height: 132rpx; border-radius: 8rpx; background: #F1F5F9; }
.progress-row { position: relative; display: flex; gap: 18rpx; min-height: 78rpx; color: #94A3B8; }.progress-row:not(:last-child)::before { content: ''; position: absolute; left: 10rpx; top: 22rpx; bottom: -4rpx; width: 2rpx; background: #E2E8F0; }.progress-dot { position: relative; z-index: 1; flex: 0 0 22rpx; width: 22rpx; height: 22rpx; margin-top: 4rpx; border-radius: 50%; border: 4rpx solid #CBD5E1; background: #fff; box-sizing: border-box; }.progress-done, .progress-current { color: #2563EB; }.progress-done .progress-dot, .progress-current .progress-dot { border-color: #2563EB; background: #2563EB; }.progress-body { padding-bottom: 12rpx; }.progress-title { font-size: 26rpx; font-weight: 650; }.progress-action { margin-top: 5rpx; font-size: 22rpx; }
.photo-row { display: flex; align-items: flex-start; justify-content: space-between; padding: 12rpx 0; color: #64748B; font-size: 25rpx; }.photo-list { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; max-width: 70%; }.remark { margin-top: 14rpx; color: #334155; font-size: 25rpx; line-height: 1.5; }.reject { margin-top: 14rpx; padding: 14rpx; color: #B91C1C; background: #FEF2F2; border-radius: 8rpx; font-size: 24rpx; }
.actions { margin-top: 28rpx; }.action-btn { width: 100%; height: 78rpx; line-height: 78rpx; border: 0; border-radius: 10rpx; background: #2563EB; color: #fff; font-size: 27rpx; }.action-btn::after { border: 0; }.waiting, .loading { padding: 120rpx 0; text-align: center; color: #94A3B8; font-size: 25rpx; }
