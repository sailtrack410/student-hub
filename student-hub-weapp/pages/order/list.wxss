.orders {
  padding: 24rpx 30rpx;
}

.filter {
  white-space: nowrap;
}

.filter-chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-card);
  margin-right: 16rpx;
  border: 2rpx solid var(--border);
}

.filter-chip-active {
  background: var(--grad-brand);
  color: #fff;
  font-weight: 600;
  border-color: transparent;
}

.list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.item-hint { margin-top: 20rpx; color: var(--brand); font-size: 23rpx; }
