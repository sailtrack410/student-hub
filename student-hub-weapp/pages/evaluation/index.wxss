.eval {
  padding: 24rpx 30rpx;
}

.mascot {
  width: 200rpx;
  height: 160rpx;
  display: block;
  margin: 10rpx auto 0;
}

.title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 34rpx;
  font-size: 64rpx;
}

.star {
  color: #E2E8F0;
  transition: transform 0.15s ease;
}

.star-on {
  color: #F59E0B;
  transform: scale(1.08);
}

.rating-text {
  text-align: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 36rpx;
}

.tag-chip {
  padding: 12rpx 28rpx;
  background: var(--bg-page);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-2);
  border: 2rpx solid transparent;
}

.tag-chip-on {
  background: var(--brand-soft);
  color: var(--brand);
  border-color: var(--brand);
  font-weight: 600;
}

.comment {
  margin-top: 34rpx;
  width: 100%;
  min-height: 160rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.ph {
  color: var(--text-3);
}

.submit {
  margin-top: 40rpx;
  height: 94rpx;
  line-height: 94rpx;
}
