.community { padding: 0 30rpx 130rpx; background: #fff; }
.community-search { height: 76rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #E8EDF3; background: #fff; }
.community-search input { flex: 1; font-size: 25rpx; }
.search-symbol { color: #2563EB; font-size: 36rpx; line-height: 1; }
.search-placeholder { color: #94A3B8; }
.search-clear { color: #94A3B8; font-size: 34rpx; }
.sections { margin: 0 -30rpx; width: calc(100% + 60rpx); white-space: nowrap; border-bottom: 1rpx solid #E8EDF3; background: #fff; }
.section-row { display: inline-flex; gap: 38rpx; padding: 0 30rpx; }
.section-tab { position: relative; display: inline-flex; align-items: center; height: 82rpx; color: #64748B; font-size: 25rpx; }
.section-tab-active { color: #1D4ED8; font-weight: 700; }
.section-tab-active::after { content: ''; position: absolute; left: 8rpx; right: 8rpx; bottom: -1rpx; height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #2563EB; }
.feed { display: flex; flex-direction: column; }
.post { padding: 30rpx 0 26rpx; border-bottom: 1rpx solid #E8EDF3; }
.author-row { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #EEF4FF; }
.author-body { flex: 1; min-width: 0; }
.author-name { font-size: 27rpx; font-weight: 700; color: #1E293B; }
.post-meta { margin-top: 6rpx; font-size: 21rpx; color: #94A3B8; }
.section-mark { width: 48rpx; height: 48rpx; }
.post-title { margin-top: 22rpx; font-size: 31rpx; font-weight: 750; color: #0F172A; }
.post-content { margin-top: 10rpx; font-size: 26rpx; color: #475569; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.post-topics { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.topic { color: #2563EB; font-size: 22rpx; }
.image-grid { margin-top: 20rpx; display: flex; gap: 10rpx; overflow: hidden; }
.image-grid-1 .post-image { width: 100%; }
.image-grid-2 .post-image { width: calc((100% - 10rpx) / 2); }
.post-image { width: calc((100% - 20rpx) / 3); height: 190rpx; border-radius: 8rpx; background: #F1F5F9; }
.image-grid-1 .post-image { height: 300rpx; }
.post-footer { margin-top: 22rpx; display: flex; align-items: center; color: #94A3B8; font-size: 22rpx; }
.post-action-group { margin-left: auto; display: flex; align-items: center; gap: 16rpx; }
.footer-action { flex: 0 0 auto; display: flex; align-items: center; gap: 6rpx; }
.share-button { flex: 0 0 42rpx; width: 42rpx; min-width: 0; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; line-height: 1; }
.share-button::after { border: none; }
.action-icon { width: 38rpx; height: 38rpx; }
.publish-fab { position: fixed; z-index: 10; right: 34rpx; bottom: calc(36rpx + env(safe-area-inset-bottom)); width: 96rpx; height: 96rpx; border-radius: 50%; background: #2563EB; color: #fff; box-shadow: 0 12rpx 28rpx rgba(37,99,235,.28); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 21rpx; }
.fab-plus { font-size: 34rpx; line-height: 1; }
.list-end { padding: 30rpx 0; text-align: center; color: #94A3B8; font-size: 22rpx; }
