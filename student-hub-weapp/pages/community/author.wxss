.author-page { padding: 24rpx 30rpx 50rpx; }
.author-hero { padding: 44rpx 30rpx 38rpx; text-align: center; border-radius: 32rpx; color: #fff; background: var(--grad-card-blue); }
.hero-avatar { width: 150rpx; height: 150rpx; border-radius: 50%; border: 6rpx solid rgba(255,255,255,.75); background: #fff; }
.author-name { margin-top: 18rpx; font-size: 36rpx; font-weight: 800; }
.author-meta-row { margin-top: 10rpx; display: flex; justify-content: center; align-items: center; gap: 18rpx; flex-wrap: wrap; }
.author-info { font-size: 23rpx; opacity: .82; }
.author-actions { display: inline-flex; align-items: center; gap: 8rpx; color: #fff; font-size: 23rpx; }
.author-actions image { width: 34rpx; height: 34rpx; }
.author-section-title { margin: 32rpx 6rpx 16rpx; font-size: 31rpx; font-weight: 750; }
.author-section-title text { margin-left: 8rpx; color: var(--text-3); font-size: 22rpx; font-weight: 400; }
.post-list { display: flex; flex-direction: column; }
.post { padding: 28rpx 0; border-bottom: 1rpx solid #E8EDF3; }
.post-title { font-size: 29rpx; font-weight: 700; }
.post-content { margin-top: 8rpx; color: var(--text-2); font-size: 25rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.image-grid { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; }
.post-image { width: 100%; height: 150rpx; border-radius: 10rpx; }
.post-topics { margin-top: 14rpx; color: #2563EB; font-size: 22rpx; }
.post-footer { margin-top: 14rpx; display: flex; justify-content: space-between; color: var(--text-3); font-size: 21rpx; }
.post-actions { display: flex; gap: 18rpx; }
