.publish-page { min-height: 100vh; padding: 0 30rpx 210rpx; background: #fff; }
.editor { min-height: calc(100vh - 250rpx); margin: 0 -30rpx; padding: 42rpx 30rpx 30rpx; border-radius: 0; box-shadow: none; background: #fff; display: flex; flex-direction: column; }.editor-compact { min-height: calc(100vh - 170rpx); }
.editor-images { width: 100%; height: 184rpx; flex-shrink: 0; white-space: nowrap; transition: height .28s ease; }.editor-image-row { display: inline-flex; gap: 14rpx; min-width: 100%; height: 184rpx; transition: height .28s ease; }.image-wrap, .image-add { position: relative; width: 184rpx; height: 184rpx; flex: 0 0 184rpx; border-radius: 14rpx; overflow: hidden; transition: width .28s ease, height .28s ease, flex-basis .28s ease; }.editor-compact .editor-images, .editor-compact .editor-image-row { height: 138rpx; }.editor-compact .image-wrap, .editor-compact .image-add { width: 138rpx; height: 138rpx; flex-basis: 138rpx; }.image { width: 100%; height: 100%; }.image-add { border: 2rpx dashed #CBD5E1; background: #F8FAFC; display: flex; align-items: center; justify-content: center; }.add-plus { font-size: 64rpx; color: #94A3B8; font-weight: 200; transition: font-size .28s ease; }.editor-compact .add-plus { font-size: 48rpx; }.image-remove { position: absolute; right: 8rpx; top: 8rpx; width: 40rpx; height: 40rpx; text-align: center; line-height: 37rpx; border-radius: 50%; color: #fff; background: rgba(15,23,42,.65); font-size: 28rpx; }
.title-input { margin-top: 42rpx; width: 100%; height: 90rpx; flex-shrink: 0; padding: 0 0 14rpx; box-sizing: border-box; border-bottom: 1rpx solid #E2E8F0; color: var(--text-1); font-size: 35rpx; font-weight: 650; }.body-input { width: 100%; height: 500rpx; flex-shrink: 0; padding: 24rpx 0 0; box-sizing: border-box; color: var(--text-1); font-size: 29rpx; line-height: 1.7; }.editor-compact .body-input { height: 620rpx; }.input-placeholder { color: #A8B2C1; }.selected-topics { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: auto; padding-top: 12rpx; }.topic { color: var(--brand); font-size: 23rpx; }
.editor-toolbar { position: fixed; left: 0; right: 0; bottom: 102rpx; z-index: 8; height: 88rpx; padding: 0 28rpx; border-top: 1rpx solid #E2E8F0; background: #fff; display: flex; align-items: center; }.meta-trigger { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 18rpx; border-radius: 12rpx; color: #475569; background: #F1F5F9; font-size: 24rpx; }.toolbar-plus { color: var(--brand); font-size: 34rpx; }.toolbar-spacer { flex: 1; }.submit-btn { position: fixed; left: 30rpx; right: 30rpx; bottom: 24rpx; z-index: 9; height: 78rpx; margin: 0; padding: 0; border-radius: 999rpx; color: #fff; background: var(--brand); display: flex; align-items: center; justify-content: center; line-height: 1; font-size: 28rpx; font-weight: 700; }.submit-btn::after { border: none; }
.sheet-done { background: var(--brand) !important; display: flex; align-items: center; justify-content: center; line-height: 1 !important; text-align: center; padding: 0; }
.sheet-mask { position: fixed; inset: 0; z-index: 20; background: rgba(15,23,42,.42); display: flex; align-items: flex-end; }.meta-sheet { width: 100%; max-height: 88vh; overflow-y: auto; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 30rpx 30rpx 0 0; background: #fff; }.sheet-head { display: flex; justify-content: space-between; align-items: center; font-size: 31rpx; font-weight: 750; }.sheet-close { font-size: 38rpx; color: #94A3B8; }.sheet-label { margin-top: 26rpx; font-size: 24rpx; color: #64748B; font-weight: 650; }.sheet-label text { margin-left: 8rpx; font-size: 20rpx; color: #94A3B8; font-weight: 400; }.sheet-sections { margin: 16rpx -30rpx 0; white-space: nowrap; }.sheet-section { display: inline-flex; align-items: center; gap: 8rpx; margin-left: 18rpx; padding: 10rpx 18rpx 10rpx 10rpx; border: 2rpx solid #E2E8F0; border-radius: 999rpx; color: #64748B; font-size: 22rpx; }.sheet-section:last-child { margin-right: 18rpx; }.sheet-section image { width: 42rpx; height: 42rpx; }.sheet-section-active { color: var(--brand); border-color: rgba(37,99,235,.3); background: var(--brand-soft); }.topic-search { margin-top: 20rpx; height: 74rpx; padding: 0 18rpx; display: flex; align-items: center; gap: 10rpx; border: 1rpx solid #E2E8F0; border-radius: 16rpx; background: #F8FAFC; }.topic-search text { color: #94A3B8; font-size: 34rpx; }.topic-search input { flex: 1; font-size: 24rpx; }.topic-label { margin-top: 22rpx; }.selected-sheet-topics { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }.selected-sheet-topics .selected { padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--brand-soft); }.add-topic-chip { padding: 8rpx 14rpx; border-radius: 999rpx; background: #F1F5F9; color: var(--brand); font-size: 22rpx; }.hot-label { margin-top: 20rpx; }.hot-topics { margin-top: 14rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }.hot-topic { min-width: 0; padding: 16rpx 18rpx; border-radius: 14rpx; background: #F8FAFC; color: #475569; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.hot-topic text { float: right; color: #94A3B8; font-size: 18rpx; }.hot-topic-active { color: var(--brand); background: var(--brand-soft); }.topic-create { display: flex; gap: 12rpx; margin-top: 20rpx; }.topic-create input { flex: 1; height: 72rpx; padding: 0 20rpx; border-radius: 16rpx; background: #F8FAFC; font-size: 24rpx; }.topic-create button { width: 110rpx; height: 72rpx; line-height: 72rpx; margin: 0; padding: 0; border-radius: 16rpx; background: #EAF0FE; color: var(--brand); font-size: 23rpx; }.topic-create button::after { border: none; }.sheet-done { margin-top: 22rpx; height: 78rpx; line-height: 78rpx; border-radius: 999rpx; color: #fff; background: var(--grad-brand); font-size: 27rpx; }.sheet-done::after { border: none; }
