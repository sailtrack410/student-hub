<view class="noti">
  <view class="toolbar">
    <text class="toolbar-title">共 {{records.length}} 条</text>
    <text class="toolbar-action" bindtap="markAll">全部已读</text>
  </view>

  <view wx:if="{{records.length}}" class="list">
    <view
      wx:for="{{records}}"
      wx:key="notificationId"
      class="item card {{item.unread ? 'item-unread' : ''}}"
      bindtap="onItemTap"
      data-index="{{index}}"
    >
      <view class="item-head">
        <view class="item-dot {{item.unread ? 'item-dot-on' : ''}}"></view>
        <text class="item-title">{{item.title}}</text>
        <text class="item-time">{{item.timeText}}</text>
      </view>
      <view class="item-content">{{item.content}}</view>
    </view>
  </view>

  <empty-state
    wx:if="{{loaded && !records.length}}"
    image="/assets/empty/empty-notifications.jpg"
    title="暂时没有消息"
    subtitle="申请进度通知会出现在这里"
  />
  <view class="safe-bottom"></view>
</view>
