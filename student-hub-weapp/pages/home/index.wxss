.home {
  padding: 0 30rpx 30rpx;
}

/* 顶部横幅 */
.hero {
  margin: 20rpx -30rpx 0;
  background: var(--grad-card-blue);
  border-radius: 0 0 44rpx 44rpx;
  padding: 44rpx 40rpx 56rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  overflow: hidden;
}

.hero-greet {
  padding-top: 10rpx;
}

.hero-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.hero-banner {
  width: 280rpx;
  height: 180rpx;
  border-radius: 24rpx;
  margin-top: 26rpx;
}

/* 快捷入口：4 列两行 */
.quick {
  margin-top: -30rpx;
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  padding: 34rpx 10rpx 10rpx;
}

.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 26rpx;
  font-size: 24rpx;
  color: var(--text-1);
  font-weight: 500;
}

.quick-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-soft);
  overflow: hidden;
}

.quick-icon image {
  width: 64rpx;
  height: 64rpx;
}

.quick-icon-schedule {
  background: var(--grad-brand-light);
  overflow: hidden;
}

.quick-icon-schedule image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
}

.quick-icon-more {
  background: var(--grad-brand-light);
}

.more-dots {
  display: flex;
  gap: 8rpx;
}

.more-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
}

/* 区块 */
.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 进展卡片 */
.progress-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.progress-icon {
  width: 72rpx;
  height: 72rpx;
}

.progress-body {
  flex: 1;
  min-width: 0;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 登录引导卡 */
.login-guide {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guide-mascot {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.guide-text {
  flex: 1;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 600;
}

.guide-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-2);
}

.guide-btn {
  background: var(--grad-brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
}

/* 常用服务 */
.services {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.service-chip {
  width: calc(50% - 10rpx);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.service-chip-icon {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.service-chip-body {
  min-width: 0;
}

.service-chip-name {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.service-chip-sla {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--accent);
}
