.schedule {
  min-height: 100vh;
  background: #F1F5F9;
}

/* 顶栏 */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
}

.head-info {
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
}

.head-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

.head-actions {
  flex-shrink: 0;
}

.btn {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-disabled {
  opacity: 0.55;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #94A3B8;
  font-size: 26rpx;
}

/* 周视图网格 */
.grid-scroll {
  margin: 0 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.grid {
  width: 1155rpx; /* 105 + 7*150 */
}

.grid-row {
  display: flex;
  border-bottom: 1rpx solid #F1F5F9;
}

.grid-row:last-child {
  border-bottom: none;
}

.grid-header {
  background: #F8FAFC;
}

/* 时间列（固定 105rpx） */
.cell-time-cell {
  width: 105rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hdr-month {
  font-size: 26rpx;
  font-weight: 700;
  color: #2563EB;
}

.cell-day {
  width: 150rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  border-left: 1rpx solid #F1F5F9;
}

.cell-time {
  width: 105rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.cell-time-first {
  background: #F8FAFC;
}

.cell-period {
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
}

.cell-section {
  font-size: 28rpx;
  color: #0F172A;
  font-weight: 700;
  margin: 4rpx 0;
}

.cell-time-range {
  font-size: 18rpx;
  color: #94A3B8;
}

/* 课程格 */
.cell {
  width: 150rpx;
  flex-shrink: 0;
  min-height: 110rpx;
  border-left: 1rpx solid #F1F5F9;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 6rpx;
}

.cell-has {
  padding: 6rpx 4rpx;
}

.course {
  display: flex;
  flex-direction: column;
  padding: 8rpx 8rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.course-name {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.course-room {
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.25;
}

.course-weeks {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #94A3B8;
}

.legend {
  padding: 12rpx 28rpx;
  color: #94A3B8;
  font-size: 22rpx;
}

.cta {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.cta-btn {
  padding: 20rpx 64rpx;
  border-radius: 44rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.safe-bottom {
  height: 40rpx;
}