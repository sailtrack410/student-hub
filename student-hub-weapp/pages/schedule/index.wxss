.schedule {
  min-height: 100vh;
  background: #F5F7FB;
  padding-bottom: 24rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
}

.head-info {
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

.btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-disabled {
  opacity: 0.55;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #94A3B8;
  font-size: 26rpx;
}

/* 周视图网格 */
.grid-scroll {
  margin: 20rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.grid {
  width: 1120rpx;
}

.grid-row {
  display: flex;
  border-bottom: 1rpx solid #EEF2F7;
}

.grid-row:last-child {
  border-bottom: none;
}

.grid-header {
  background: #F8FAFC;
}

.cell-time-cell {
  width: 112rpx;
  flex-shrink: 0;
}

.cell-day {
  width: 144rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  border-left: 1rpx solid #EEF2F7;
}

.cell-time {
  width: 112rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}

.cell-period {
  font-size: 22rpx;
  color: #94A3B8;
}

.cell-section {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  margin-top: 4rpx;
}

.cell {
  width: 144rpx;
  flex-shrink: 0;
  min-height: 92rpx;
  padding: 8rpx;
  border-left: 1rpx solid #EEF2F7;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cell-has {
  background: #EFF6FF;
}

.course {
  display: flex;
  flex-direction: column;
  padding: 8rpx 6rpx;
  border-radius: 8rpx;
  background: #DBEAFE;
}

.course-name {
  font-size: 22rpx;
  color: #1D4ED8;
  font-weight: 600;
  line-height: 1.3;
}

.course-room {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748B;
  line-height: 1.2;
}

.legend {
  padding: 8rpx 28rpx;
  color: #94A3B8;
  font-size: 22rpx;
}

.cta {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.cta-btn {
  padding: 20rpx 64rpx;
  border-radius: 44rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.safe-bottom {
  height: 40rpx;
}