<view class="hall">
  <view class="search">
    <image class="search-icon" src="/assets/tab/tab-service.png" mode="aspectFit" />
    <input class="search-input" placeholder="搜索办事服务" placeholder-class="ph"
           value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
  </view>

  <!-- 课表入口 -->
  <view class="schedule-entry card" bindtap="goSchedule">
    <image class="schedule-entry-icon" src="/assets/identity/icon-schedule.png" mode="aspectFit" />
    <view class="schedule-entry-left">
      <view class="schedule-entry-title">我的课表</view>
      <view class="schedule-entry-sub">查看每周课程安排</view>
    </view>
    <view class="schedule-entry-arrow">›</view>
  </view>

  <!-- 结果与排序 -->
  <view class="toolbar">
    <text class="toolbar-count">共 {{totalCount}} 项服务</text>
    <picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange">
      <view class="sort-chip">
        <text>{{sortOptions[sortIndex]}}</text>
        <text class="sort-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 分类分组列表 -->
  <view class="groups">
    <view wx:for="{{groups}}" wx:key="categoryId" wx:for-item="group" class="group">
      <view class="group-head">
        <image class="group-icon" src="/assets/category/{{group.icon || 'cat-affair'}}.png" mode="aspectFit" />
        <text class="group-name">{{group.categoryName}}</text>
        <text class="group-count">{{group.items.length}} 项</text>
      </view>
      <view class="group-items">
        <navigator
          wx:for="{{group.items}}"
          wx:key="itemId"
          wx:for-item="item"
          class="item-card card"
          url="/pages/service/apply?itemId={{item.itemId}}"
          hover-class="item-card-hover"
        >
          <image class="item-icon" src="/assets/category/{{item.icon || 'cat-affair'}}.png" mode="aspectFit" />
          <view class="item-body">
            <view class="item-name">{{item.itemName}}</view>
            <view class="item-summary">{{item.summary}}</view>
          </view>
          <view wx:if="{{item.slaHours}}" class="item-sla">{{item.slaHours}}h</view>
        </navigator>
      </view>
    </view>

    <empty-state
      wx:if="{{loaded && !groups.length}}"
      image="/assets/empty/empty-search.jpg"
      title="没有找到相关服务"
      subtitle="换个关键词试试"
    />
  </view>

  <view class="safe-bottom"></view>
</view>
