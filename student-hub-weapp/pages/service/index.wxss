.hall {
  padding: 24rpx 30rpx;
}

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 20rpx 30rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.ph {
  color: var(--text-3);
}

/* 结果与排序 */
.toolbar {
  margin-top: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toolbar-count {
  font-size: 24rpx;
  color: var(--text-2);
}

.sort-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: var(--text-1);
  border: 2rpx solid var(--border);
}

.sort-arrow {
  color: var(--text-3);
  font-size: 20rpx;
}

/* 分类分组 */
.groups {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.group-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 6rpx 18rpx;
}

.group-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.group-body {
  flex: 1;
  min-width: 0;
}

.group-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
}

.group-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-count {
  flex-shrink: 0;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.group-items {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.item-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
}

.item-icon {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.item-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-sla {
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
  flex-shrink: 0;
}
