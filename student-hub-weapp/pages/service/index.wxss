.hall {
  padding: 24rpx 30rpx;
}

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 20rpx 30rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.ph {
  color: var(--text-3);
}

/* 分类 */
.cats {
  margin-top: 26rpx;
  white-space: nowrap;
}

/* 结果与排序 */
.toolbar {
  margin-top: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toolbar-count {
  font-size: 24rpx;
  color: var(--text-2);
}

.sort-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: var(--text-1);
  border: 2rpx solid var(--border);
}

.sort-arrow {
  color: var(--text-3);
  font-size: 20rpx;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 16rpx;
  border: 2rpx solid var(--border);
}

.cat-chip-icon {
  width: 40rpx;
  height: 40rpx;
}

.cat-chip-active {
  background: var(--grad-brand);
  color: #fff;
  border-color: transparent;
  font-weight: 600;
}

/* 列表 */
.items {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
}

.item-icon {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.item-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-sla {
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
  flex-shrink: 0;
}
