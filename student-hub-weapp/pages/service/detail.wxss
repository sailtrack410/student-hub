.detail {
  padding: 24rpx 30rpx;
  padding-bottom: 160rpx;
}

.head {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.head-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.head-name {
  font-size: 36rpx;
  font-weight: 700;
}

.head-summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.head-sla {
  display: inline-block;
  margin-top: 16rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.guide-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-2);
}

.field-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-row {
  display: flex;
  justify-content: space-between;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  padding: 18rpx 24rpx;
  font-size: 25rpx;
}

.field-name {
  color: var(--text-1);
  font-weight: 500;
}

.field-type {
  color: var(--text-3);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 30rpx;
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.06);
}

.apply-btn {
  height: 92rpx;
  line-height: 92rpx;
}
