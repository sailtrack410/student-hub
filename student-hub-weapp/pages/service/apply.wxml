<view class="apply">
  <view class="head card">
    <image class="head-icon" src="/assets/category/{{item.icon || 'cat-affair'}}.png" mode="aspectFit" />
    <view class="head-body">
      <view class="head-name">{{item.itemName}}</view>
      <view wx:if="{{item.slaHours}}" class="head-sla">预计 {{item.slaHours}} 小时内办结</view>
    </view>
    <view class="head-guide" bindtap="goGuide">办事指南 ›</view>
  </view>

  <view class="card section">
    <form-renderer schema="{{schema}}" bindchange="onFormChange" />
  </view>

  <view wx:if="{{submitted}}" class="card success">
    <image class="success-img" src="/assets/success/success-submit.jpg" mode="aspectFit" />
    <view class="success-title">提交成功！</view>
    <view class="success-no">申请编号 {{submitted.requestNo}}</view>
    <view class="success-actions">
      <button class="btn-ghost" bindtap="goDetail">查看进度</button>
      <button class="btn-primary" bindtap="again">再办一件</button>
    </view>
  </view>

  <button wx:else class="btn-primary submit" loading="{{loading}}" disabled="{{loading}}" bindtap="handleSubmit">
    提交申请
  </button>

  <view class="safe-bottom"></view>
</view>
