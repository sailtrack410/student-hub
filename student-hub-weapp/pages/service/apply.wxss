.apply {
  padding: 24rpx 30rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.head-icon {
  width: 90rpx;
  height: 90rpx;
}

.head-name {
  font-size: 32rpx;
  font-weight: 700;
}

.head-sla {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--accent-deep);
  background: var(--accent-soft);
  display: inline-block;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.section {
  margin-top: 24rpx;
}

.submit {
  margin-top: 40rpx;
  height: 94rpx;
  line-height: 94rpx;
}

.success {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 40rpx;
}

.success-img {
  width: 260rpx;
  height: 200rpx;
}

.success-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.success-no {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.success-actions {
  margin-top: 36rpx;
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.success-actions button {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}
