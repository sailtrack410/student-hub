.chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
}

.messages {
  flex: 1;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

/* 欢迎卡 */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

.welcome-mascot {
  width: 240rpx;
  height: 220rpx;
}

.welcome-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.welcome-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.suggests {
  margin-top: 36rpx;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.suggest {
  background: var(--bg-card);
  border: 2rpx solid var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
}

/* 消息 */
.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 26rpx;
  align-items: flex-start;
}

.msg-row-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid var(--accent-soft);
}

.bubble {
  display: block;
  max-width: 480rpx;
  background: var(--bg-card);
  border-radius: 6rpx 28rpx 28rpx 28rpx;
  padding: 22rpx 26rpx;
  font-size: 27rpx;
  line-height: 1.7;
  box-shadow: var(--shadow-card);
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble-wrap {
  max-width: 520rpx;
  min-width: 0;
}

/* 动作卡片入口 */
.action-cards {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-width: 520rpx;
}

.action-card {
  background: var(--bg-card);
  border: 2rpx solid var(--brand-soft);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-card);
}

.action-card::after {
  border: none;
}

.action-label {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
}

.action-arrow {
  font-size: 34rpx;
  color: var(--brand);
  line-height: 1;
}

.bubble-user {
  background: var(--grad-brand);
  color: #fff;
  border-radius: 28rpx 6rpx 28rpx 28rpx;
}

.audio-message {
  min-width: 250rpx;
  min-height: 76rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--grad-brand);
  color: #fff;
  border-radius: 28rpx 6rpx 28rpx 28rpx;
  box-sizing: border-box;
}

.audio-message-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) invert(1);
}

.audio-message-label {
  flex: 1;
  font-size: 26rpx;
}

.audio-message-duration {
  font-size: 23rpx;
  opacity: 0.86;
}

.bubble-degraded {
  background: var(--warning-soft);
  color: var(--text-2);
}

.bubble-thinking {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 30rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
  opacity: 0.4;
  animation: blink 1.2s infinite;
}

.dot-2 {
  animation-delay: 0.2s;
}

.dot-3 {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 100% { opacity: 0.25; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-4rpx); }
}

.msg-padding {
  height: 30rpx;
}

/* 用户消息内图片：按原宽高比展示 */
.message-images {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 10rpx;
  max-width: 440rpx;
}

.message-image {
  max-width: 440rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  background: #fff;
}

/* 待发送图片预览 */
.pending-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx 14rpx;
  background: var(--bg-card);
}

.pending-item {
  position: relative;
  width: 110rpx;
  height: 110rpx;
}

.pending-image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--brand-soft);
}

.pending-remove {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  background: rgba(15, 23, 42, 0.72);
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
}

/* 输入区 */
.input-bar {
  display: flex;
  gap: 8rpx;
  margin: 12rpx 24rpx 18rpx;
  padding: 10rpx 14rpx;
  background: #F7F8FA;
  border: 1rpx solid #E5E7EB;
  border-radius: 999rpx;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

/* 语音模式下切回键盘 */
.mode-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background: #E9EDF2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

.mode-btn::after {
  border: none;
}

.input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  border-radius: 0;
  padding: 0 10rpx;
  font-size: 28rpx;
}

.ph {
  color: var(--text-3);
}

/* 微信式加号入口 */
.add-btn,
.voice-switch-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background: #E9EDF2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  flex-shrink: 0;
}

.add-btn::after,
.voice-switch-btn::after,
.mode-btn::after {
  border: none;
}

.add-btn[disabled],
.voice-switch-btn[disabled],
.mode-btn[disabled] {
  opacity: 0.45;
}

.input-icon {
  width: 42rpx;
  height: 42rpx;
}

/* 按住说话区域 */
.voice-btn {
  flex: 1;
  height: 72rpx;
  margin: 0;
  background: transparent;
  color: var(--text-1);
  font-size: 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.voice-btn::after {
  border: none;
}

.voice-btn-recording {
  background: #fee2e2;
  color: #dc2626;
}
