DB_NAME=student_hub
DB_USERNAME=student_hub
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-root-local-only
DB_URL=jdbc:mysql://localhost:3306/student_hub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_PORT=3306
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SERVER_PORT=9000
SESSION_STORE=redis
SESSION_TTL=8h
# App 端会话有效期与滑动续期阈值：App 是长期免登录（30 天 + 剩余不足 7 天时续期），
# 必须同时带请求头 x-client-type: app 才会命中这套长 TTL；否则按 SESSION_TTL 处理。
APP_SESSION_TTL=30d
SESSION_RENEW_THRESHOLD=7d
APP_CLIENT_HEADER=x-client-type
APP_CLIENT_VALUE=app
PASSWORD_LOGIN_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 管理端配置中心敏感值加密主密钥（必须，至少 16 字符；建议 32+ 随机串）。
# 用于加密 QQ APP KEY、微信 AppSecret、SMTP 密码，泄露后已落库密钥可被解密。
CONFIG_SECRET_KEY=

# AI is disabled by default. Set these only in a local, untracked .env file.
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# RAG knowledge base: needs a separate PostgreSQL instance. Disabled by default.
# pgvector is optional; without it vector recall uses exact cosine scan (see README).
RAG_ENABLED=false
RAG_DB_URL=jdbc:postgresql://localhost:5435/postgres
RAG_DB_USERNAME=
RAG_DB_PASSWORD=
RAG_MAX_DOCUMENT_SIZE_MB=30
RAG_MAX_PARSED_CHARACTERS=2000000
RAG_EMBEDDING_BATCH_SIZE=16
RAG_LEXICAL_CANDIDATE_LIMIT=40
RAG_VECTOR_CANDIDATE_LIMIT=40
RAG_LEXICAL_MIN_SIMILARITY=0.05
RAG_RRF_K=60

# WeChat login config. Real credentials must NOT be committed.
WECHAT_MODE=real
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_DEFAULT_CAMPUS_ID=1
WECHAT_CONNECT_TIMEOUT_SECONDS=5
WECHAT_READ_TIMEOUT_SECONDS=10

# QQ login config.
# mock: derive stable identity from accessToken (no external call, local dev only).
# real: verify the QQ SDK accessToken against graph.qq.com (mobile app must be approved by QQ Interconnect).
#       Server checks /me client_id against this APP ID (falls back to /user/get_user_info with
#       oauth_consumer_key=APP ID) to reject tokens issued to other apps. Real mobile flow only
#       needs QQ_CLIENT_ID; QQ_CLIENT_SECRET is
#       reserved for a future website/authorization-code flow and should not be exposed to clients.
# Credentials must NOT be committed.
QQ_MODE=mock
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
QQ_API_BASE_URL=https://graph.qq.com
QQ_DEFAULT_CAMPUS_ID=1
QQ_CONNECT_TIMEOUT_SECONDS=5
QQ_READ_TIMEOUT_SECONDS=10

# Campus email verification codes (SMTP). Real credentials must NOT be committed.
# Default off for local development: dev/test responses expose devCode directly.
# For production set MAIL_ENABLED=true and provide host/username/password/from.
# Port 465: MAIL_SSL_ENABLED=true, MAIL_STARTTLS_ENABLED=false
# Port 587: MAIL_SSL_ENABLED=false, MAIL_STARTTLS_ENABLED=true
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=绵城一码通
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
# Only honored under dev/test profiles; production never returns the code.
MAIL_DEV_RETURN_CODE=true

# File storage: local (default), minio or oss. Credentials must NOT be committed.
# 首次启动会迁移到管理端「文件存储」配置；之后优先使用管理端数据库值。
FILE_STORAGE=local
FILE_STORAGE_DIR=./data/files
FILE_SIGN_SECRET=change-me-to-a-random-secret
FILE_MAX_SIZE_MB=5
FILE_VIEW_TTL_MINUTES=30
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=student-hub
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 阿里云 OSS（FILE_STORAGE=oss 时使用；AK/SK 不要提交）
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# JW (Kingosoft) auth: session cookie encryption key must be a random secret in prod.
JW_ENCRYPT_KEY=change-me-to-a-random-secret
JW_SSO_BASE_URL=https://sso.mycc.edu.cn
JW_JW_BASE_URL=https://jwgl.mycc.edu.cn
JW_CAS_SERVICE=http://jwgl.mycc.edu.cn/caslogin
JW_SESSION_TTL_HOURS=48
JW_CONNECT_TIMEOUT_SECONDS=5
JW_READ_TIMEOUT_SECONDS=15
JW_AUTH_RATE_LIMIT_PER_MINUTE=5

# 高德 Web 服务 Key（附近地点/逆地理编码，仅后端使用）
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_CONNECT_TIMEOUT_SECONDS=5
AMAP_READ_TIMEOUT_SECONDS=8
